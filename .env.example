# Copy to .env to override. All values below are the defaults.
MAX_UPLOAD_MB=500
MAX_DURATION_SEC=3600
STORAGE_DIR=/data
# Comma-separated list of origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173
# Clip length bounds for segmentation, in seconds. MIN must be at most half of MAX.
MIN_CLIP_SEC=15
MAX_CLIP_SEC=60
